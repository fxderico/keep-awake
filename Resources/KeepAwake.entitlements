<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Keep Awake is distributed outside the App Store (ad-hoc signed DMG), so it
      intentionally runs unsandboxed: IOPMAssertionCreateWithName, IOPowerSources,
      and SMAppService all work without any sandbox exceptions in that mode.
      com.apple.security.app-sandbox is left out entirely rather than set to false,
      since Xcode's hardened-runtime signing is happiest with an empty/absent key
      for non-sandboxed apps.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <false/>
</dict>
</plist>
